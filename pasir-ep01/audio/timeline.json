 "cues": [
  {
   "id": "L01",
   "who": "NANDO",
   "kind": "dialog",
   "text": "Hah? Rumah?",
   "est": 1.1,
   "start": 17.4,
   "end": 18.5,
   "shot": "s07"
  },
  {
   "id": "L02",
   "who": "NANDO",
   "kind": "narasi",
   "text": "Awalnya gue pikir itu cuma kesalahan sistem.",
   "est": 3,
   "start": 19,
   "end": 22,
   "shot": "s08"
  },
  {
   "id": "L03",
   "who": "NANDO",
   "kind": "narasi",
   "text": "Tapi gue nggak tahu… kalau hari itu bakal jadi hari yang paling gue sesali.",
   "est": 4.8,
   "start": 22.15,
   "end": 26.95,
   "shot": "s09"
  },
  {
   "id": "L04",
   "who": "NANDO",
   "kind": "dialog",
   "text": "Angkat, Pa…",
   "est": 1.3,
   "start": 35.1,
   "end": 36.4,
   "shot": "s14"
  },
  {
   "id": "L05",
   "who": "NANDO",
   "kind": "narasi",
   "text": "Papa bukan orang yang suka mengabaikan telepon. Apalagi kalau gue menelepon berkali-kali.",
   "est": 5.6,
   "start": 37.1,
   "end": 42.7,
   "shot": "s15"
  },
  {
   "id": "L06",
   "who": "NANDO",
   "kind": "dialog",
   "text": "Pak, bisa tolong cek rumah saya? Alarmnya tiba-tiba aktif.",
   "est": 3.6,
   "start": 43.5,
   "end": 47.1,
   "shot": "s16"
  },
  {
   "id": "L07",
   "who": "SATPAM",
   "kind": "phone",
   "text": "Baik, Pak. Saya coba periksa.",
   "est": 1.9,
   "start": 47.2,
   "end": 49.1,
   "shot": "s16"
  },
  {
   "id": "L08",
   "who": "NANDO",
   "kind": "dialog",
   "text": "Tolong kabari saya secepatnya.",
   "est": 1.8,
   "start": 49.2,
   "end": 51,
   "shot": "s17"
  },
  {
   "id": "L09",
   "who": "NANDO",
   "kind": "dialog",
   "text": "Halo? Gimana rumah saya?",
   "est": 1.6,
   "start": 62.35,
   "end": 63.95,
   "shot": "s22"
  },
  {
   "id": "L10",
   "who": "SATPAM",
   "kind": "phone",
   "text": "Maaf, Pak. Saya belum berhasil menghubungi orang di rumah.",
   "est": 3.4,
   "start": 64.15,
   "end": 67.55,
   "shot": "s22"
  },
  {
   "id": "L11",
   "who": "NANDO",
   "kind": "dialog",
   "text": "Terus sekarang gimana?",
   "est": 1.3,
   "start": 67.7,
   "end": 69,
   "shot": "s22"
  },
  {
   "id": "L12",
   "who": "SATPAM",
   "kind": "phone",
   "text": "Saya sarankan Bapak segera pulang dan memeriksanya.",
   "est": 2.9,
   "start": 69.6,
   "end": 72.5,
   "shot": "s23"
  },
  {
   "id": "L13",
   "who": "NANDO",
   "kind": "dialog",
   "text": "Iya. Saya sudah menuju ke sana.",
   "est": 1.9,
   "start": 72.6,
   "end": 74.5,
   "shot": "s23"
  },
  {
   "id": "L14",
   "who": "NANDO",
   "kind": "narasi",
   "text": "Gue mulai berpikir macam-macam.",
   "est": 2,
   "start": 74.7,
   "end": 76.7,
   "shot": "s24"
  },
  {
   "id": "L15",
   "who": "NANDO",
   "kind": "narasi",
   "text": "Tapi satu hal yang terus ada di kepala gue…",
   "est": 2.6,
   "start": 76.8,
   "end": 79.4,
   "shot": "s24"
  },
  {
   "id": "L16",
   "who": "NANDO",
   "kind": "narasi",
   "text": "Papa ada di rumah. Setidaknya, seharusnya begitu.",
   "est": 3.4,
   "start": 79.5,
   "end": 82.9,
   "shot": "s25"
  },
  {
   "id": "L17",
   "who": "NANDO",
   "kind": "dialog",
   "text": "Papa?",
   "est": 0.8,
   "start": 91,
   "end": 91.8,
   "shot": "s28"
  },
  {
   "id": "L18",
   "who": "NANDO",
   "kind": "dialog",
   "text": "Papa!?",
   "est": 1,
   "start": 99.2,
   "end": 100.2,
   "shot": "s31"
  },
  {
   "id": "L19",
   "who": "NANDO",
   "kind": "narasi",
   "text": "Gue udah periksa hampir seluruh rumah.",
   "est": 2.4,
   "start": 104.1,
   "end": 106.5,
   "shot": "s33"
  },
  {
   "id": "L20",
   "who": "NANDO",
   "kind": "narasi",
   "text": "Tapi Papa nggak ada.",
   "est": 1.6,
   "start": 107.1,
   "end": 108.7,
   "shot": "s34"
  },
  {
   "id": "L21",
   "who": "NANDO",
   "kind": "dialog",
   "text": "Ini… punya Papa.",
   "est": 1.8,
   "start": 115.7,
   "end": 117.5,
   "shot": "s37"
  },
  {
   "id": "L22",
   "who": "NANDO",
   "kind": "dialog",
   "text": "Pasir?",
   "est": 0.9,
   "start": 124.9,
   "end": 125.8,
   "shot": "s40"
  },
  {
   "id": "L23",
   "who": "NANDO",
   "kind": "dialog",
   "text": "Siapa yang masuk ke rumah ini?",
   "est": 1.9,
   "start": 126.7,
   "end": 128.6,
   "shot": "s41"
  },
  {
   "id": "L24",
   "who": "NANDO",
   "kind": "narasi",
   "text": "Gue nggak ngerti.",
   "est": 1.2,
   "start": 129.1,
   "end": 130.3,
   "shot": "s42"
  },
  {
   "id": "L25",
   "who": "NANDO",
   "kind": "narasi",
   "text": "Kenapa rumah gue berantakan?",
   "est": 1.7,
   "start": 130.55,
   "end": 132.25,
   "shot": "s42"
  },
  {
   "id": "L26",
   "who": "NANDO",
   "kind": "narasi",
   "text": "Kenapa Papa nggak ada?",
   "est": 1.5,
   "start": 132.45,
   "end": 133.95,
   "shot": "s42"
  },
  {
   "id": "L27",
   "who": "NANDO",
   "kind": "narasi",
   "text": "Dan yang paling aneh…",
   "est": 1.6,
   "start": 134.4,
   "end": 136,
   "shot": "s43"
  },
  {
   "id": "L28",
   "who": "NANDO",
   "kind": "narasi",
   "text": "Kenapa ada pasir sebanyak ini?",
   "est": 2,
   "start": 136.4,
   "end": 138.4,
   "shot": "s43"
  },
  {
   "id": "L29",
   "who": "NANDO",
   "kind": "dialog",
   "text": "Siapa yang ngirim ini?!",
   "est": 1.4,
   "start": 148.6,
   "end": 150,
   "shot": "s48"
  },
  {
   "id": "L30",
   "who": "NANDO",
   "kind": "dialog",
   "text": "HEI! LO SIAPA?! PAPA GUE DI MANA?!",
   "est": 2.4,
   "start": 152.05,
   "end": 154.45,
   "shot": "s50"
  },
  {
   "id": "L31",
   "who": "MISTERIUS",
   "kind": "phone",
   "text": "Sepertinya kamu sudah menemukan petunjuknya.",
   "est": 3,
   "start": 156.4,
   "end": 159.4,
   "shot": "s51"
  },
  {
   "id": "L32",
   "who": "NANDO",
   "kind": "dialog",
   "text": "PETUNJUK APA?!",
   "est": 1.1,
   "start": 159.7,
   "end": 160.8,
   "shot": "s52"
  },
  {
   "id": "L33",
   "who": "MISTERIUS",
   "kind": "phone",
   "text": "Perhatikan pasirnya.",
   "est": 1.6,
   "start": 161.15,
   "end": 162.75,
   "shot": "s52"
  },
  {
   "id": "L34",
   "who": "NANDO",
   "kind": "narasi",
   "text": "Sejak saat itu, gue tahu…",
   "est": 1.9,
   "start": 178.2,
   "end": 180.1,
   "shot": "s58"
  },
  {
   "id": "L35",
   "who": "NANDO",
   "kind": "narasi",
   "text": "Ini bukan sekadar pencurian.",
